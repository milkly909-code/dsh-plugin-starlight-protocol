{
  "name": "dsh-plugin-starlight-protocol",
  "version": "1.0.0",
  "description": "星轨协议 2077 (Starlight Protocol) — 集成开机冷启动认证序列、赛博朋克 2077 HUD 终端主题与全域通透深空天体引擎的旗舰综合外观系统",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "theme",
    "appearance",
    "startup",
    "splash",
    "background",
    "cyberpunk"
  ],
  "dsh": {
    "manifestVersion": 1,
    "displayName": "星轨协议 2077 (Starlight Protocol)",
    "description": "DeepSeek Harness 旗舰级综合外观系统：集成星海折跃开机认证序列、赛博朋克 2077 全套 HUD 终端主题与全域通透深空天体引擎，支持模块化自主启闭。",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "cordis": {
    "bundles": [
      "lib/client.js"
    ]
  }
}
