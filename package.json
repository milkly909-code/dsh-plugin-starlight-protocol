{
  "name": "@local/space-background",
  "version": "1.1.0",
  "description": "深空背景 (Deep Space Background) — DSH 全域通透沉浸式宇宙视界：界面彻底无模糊(0px blur)全透展现，统一聊天框与全界面无模糊一致性，嵌入插件详情页专属项目技术全景说明，集成 360° 无缝流动银河、3D 相机正交投影星座、光环巨行星与穿梭流星，具备太空 HUD 全息文字防晕散保护与节能架构。",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "appearance",
    "background",
    "starfield"
  ],
  "license": "MIT",
  "author": "milkly909-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milkly909-code/dsh-space-background.git"
  },
  "homepage": "https://github.com/milkly909-code/dsh-space-background#readme",
  "bugs": {
    "url": "https://github.com/milkly909-code/dsh-space-background/issues"
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js && node test/run.cjs",
    "test": "node test/run.cjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
