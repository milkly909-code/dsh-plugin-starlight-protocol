{
  "name": "@local/space-background",
  "version": "1.2.1",
  "description": "深空背景 (Deep Space Background) — DSH 全域通透沉浸式宇宙视界：界面彻底无模糊(0px blur)全透展现，优雅解决文字上滑遮挡，悬浮控制面板支持点击外部自动关闭，全景玻璃不透明度实时生效调节。",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "appearance",
    "background",
    "starfield"
  ],
  "license": "MIT",
  "author": "milkly909-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milkly909-code/dsh-space-background.git"
  },
  "homepage": "https://github.com/milkly909-code/dsh-space-background#readme",
  "bugs": {
    "url": "https://github.com/milkly909-code/dsh-space-background/issues"
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js && node test/run.cjs",
    "test": "node test/run.cjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
