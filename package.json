{
  "name": "@local/space-background",
  "version": "1.2.8",
  "description": "深空背景 (Deep Space Background) — DSH 全域通透沉浸式宇宙视界：浅色与深色模式下星空 100% 完整穿透展现（绝不被白底遮挡），全域侧栏、外观卡片与文字全息纯白HUD立体高对比显示，彻底消除菜单与卡片内部嵌套灰色边框，全息微光胶囊微标美化，底部状态栏与Token用量高对比，吸底座席双模平滑渐隐防穿透，聊天输入悬浮舱，悬浮调控面板支持外部点击收起。",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "appearance",
    "background",
    "starfield"
  ],
  "license": "MIT",
  "author": "milkly909-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milkly909-code/dsh-space-background.git"
  },
  "homepage": "https://github.com/milkly909-code/dsh-space-background#readme",
  "bugs": {
    "url": "https://github.com/milkly909-code/dsh-space-background/issues"
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js && node test/run.cjs",
    "test": "node test/run.cjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
