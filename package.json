{
  "name": "@local/space-background",
  "version": "2.1.1",
  "description": "深空背景 (Deep Space Background) — 主题令牌驱动的沉浸式星空视界。深色=深空半透玻璃+纯白HUD文字；浅色=晨雾磨砂玻璃+深色高对比文字。27 个官方 --dsw-* 令牌接管全部视觉，保留 DSH 原生圆角/层次/阴影，彻底告别通配符暴力覆盖造成的细节错乱。",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "appearance",
    "background",
    "starfield"
  ],
  "license": "MIT",
  "author": "milkly909-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milkly909-code/dsh-space-background.git"
  },
  "homepage": "https://github.com/milkly909-code/dsh-space-background#readme",
  "bugs": {
    "url": "https://github.com/milkly909-code/dsh-space-background/issues"
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js && node test/run.cjs && node test/engine.cjs",
    "test": "node test/run.cjs && node test/engine.cjs",
    "visual": "node test/visual.cjs",
    "verify": "npm run check && npm run visual"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
