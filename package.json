{
  "name": "@local/space-background",
  "version": "1.0.1",
  "description": "深空背景 — DSH 主题与视觉控制中心：在左侧边栏提供独立控制页面，可无级调节界面通透度与毛玻璃磨砂效果，并具备智能文字反转与抗晕散微阴影保护，确保深空宇宙壁纸绚烂透出的同时文字清晰锐利。",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "appearance",
    "background",
    "starfield"
  ],
  "license": "MIT",
  "author": "milkly909-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milkly909-code/dsh-space-background.git"
  },
  "homepage": "https://github.com/milkly909-code/dsh-space-background#readme",
  "bugs": {
    "url": "https://github.com/milkly909-code/dsh-space-background/issues"
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js && node test/run.cjs",
    "test": "node test/run.cjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
